{"id": "IP-A01", "group": "non_canonical", "injury": true, "channel": "email", "text": "Kazada boynum incindi, doktora gittim.", "note": "incinme + doktor; sözlükte ikisi de yok"}
{"id": "IP-A02", "group": "non_canonical", "injury": true, "channel": "email", "text": "Çarpışmadan sonra başım döndü, sağlık ekibi geldi.", "note": "sağlık ekibi"}
{"id": "IP-A03", "group": "non_canonical", "injury": true, "channel": "email", "text": "Eşimin kolu kırıldı.", "note": "kırıldı, terim kırık'ı içermiyor"}
{"id": "IP-A04", "group": "non_canonical", "injury": true, "channel": "call_transcript", "text": "Müşteri: 112'yi aradık, olay yerine geldiler.", "note": "112"}
{"id": "IP-A05", "group": "non_canonical", "injury": true, "channel": "call_transcript", "text": "Müşteri: Arkadaşım direksiyona çarpıp bayıldı.", "note": "bayılma"}
{"id": "IP-A06", "group": "non_canonical", "injury": true, "channel": "call_transcript", "text": "Müşteri: Sürücü nefes alamıyordu.", "note": "solunum"}
{"id": "IP-A07", "group": "non_canonical", "injury": true, "channel": "email", "text": "Boynuma boyunluk taktılar.", "note": "tedavi izi"}
{"id": "IP-A08", "group": "non_canonical", "injury": true, "channel": "email", "text": "Beyin sarsıntısı geçirdi.", "note": "bilinç terimi geçmiyor"}
{"id": "IP-A09", "group": "non_canonical", "injury": true, "channel": "web_form", "text": "Açıklama: Dikiş attırmak zorunda kaldım.", "note": "tedavi izi"}
{"id": "IP-A10", "group": "non_canonical", "injury": true, "channel": "web_form", "text": "Açıklama: Bacağımı alçıya aldılar.", "note": "tedavi izi"}
{"id": "IP-A11", "group": "non_canonical", "injury": true, "channel": "email", "text": "Kaburgam çatladı.", "note": "çatlak, kırık değil"}
{"id": "IP-A12", "group": "non_canonical", "injury": true, "channel": "call_transcript", "text": "Müşteri: Acilde dört saat bekledik.", "note": "acilde; terim 'acil servis' tam ifadesi"}
{"id": "IP-A13", "group": "non_canonical", "injury": true, "channel": "email", "text": "Omzum çıktı, kolumu kaldıramıyorum.", "note": "çıkık"}
{"id": "IP-A14", "group": "non_canonical", "injury": true, "channel": "call_transcript", "text": "Müşteri: Sağlık görevlileri olay yerinde müdahale etti.", "note": "sağlık görevlisi"}
{"id": "IP-B01", "group": "ascii_fold", "injury": true, "channel": "web_form", "text": "Aciklama: Kazada yarali var, hemen donus yapin.", "note": "yaralı -> yarali"}
{"id": "IP-B02", "group": "ascii_fold", "injury": true, "channel": "web_form", "text": "Aciklama: Maalesef olu var, polis geldi.", "note": "ölü -> olu"}
{"id": "IP-B03", "group": "ascii_fold", "injury": true, "channel": "email", "text": "Kolumda kirik var, cok agri yapiyor.", "note": "kırık -> kirik; kanonik terim bilerek yok"}
{"id": "IP-B04", "group": "ascii_fold", "injury": true, "channel": "call_transcript", "text": "Musteri: Bilinc kaybi vardi, kendine gelemedi.", "note": "bilinç -> bilinc"}
{"id": "IP-B05", "group": "ascii_fold", "injury": true, "channel": "email", "text": "Kaza sonrasi yaralandi, durumu ciddi.", "note": "yaralandı -> yaralandi"}
{"id": "IP-C01", "group": "false_positive_control", "injury": false, "channel": "email", "text": "Aracı hastane otoparkında çizdiler.", "note": "hastane tetiklemesi bekleniyor"}
