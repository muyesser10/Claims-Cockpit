{"id": "IP-C06", "group": "false_positive_control", "injury": false, "channel": "email", "text": "Sedye taşıyan bir araca çarptım.", "note": "sedye tetiklemesi bekleniyor"}
{"id": "IP-C07", "group": "false_positive_control", "injury": false, "channel": "email", "text": "Acil servis tabelasına çarptım.", "note": "acil servis tetiklemesi bekleniyor"}
{"id": "IP-C08", "group": "false_positive_control", "injury": false, "channel": "email", "text": "Ölüm virajında kaza yaptım.", "note": "ölüm -> yer adı"}
{"id": "IP-C09", "group": "false_positive_control", "injury": false, "channel": "email", "text": "Kanatlı hayvan ön cama çarptı.", "note": "kan -> kanatlı, açık #1"}
