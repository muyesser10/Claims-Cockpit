{
  "uid": "claims-cockpit-queue-operations",
  "title": "Claims-Cockpit — Queue & Operations",
  "tags": ["claims-cockpit", "s3-9"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "15s",
  "time": { "from": "now-6h", "to": "now" },
  "panels": [
    {
      "id": 1,
      "title": "Claims in_human_review (current)",
      "type": "stat",
      "gridPos": { "x": 0, "y": 0, "w": 6, "h": 6 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "claims_in_human_review_total",
          "legendFormat": "in_human_review",
          "refId": "A"
        }
      ]
    },
    {
      "id": 2,
      "title": "Claims approved (cumulative)",
      "type": "stat",
      "gridPos": { "x": 6, "y": 0, "w": 6, "h": 6 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "claims_approved_total",
          "legendFormat": "approved",
          "refId": "A"
        }
      ]
    },
    {
      "id": 3,
      "title": "Claims rejected (cumulative)",
      "type": "stat",
      "gridPos": { "x": 12, "y": 0, "w": 6, "h": 6 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "claims_rejected_total",
          "legendFormat": "rejected",
          "refId": "A"
        }
      ]
    },
    {
      "id": 4,
      "title": "Avg wait time, routing → decision (last 100)",
      "type": "stat",
      "gridPos": { "x": 18, "y": 0, "w": 6, "h": 6 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "claims_avg_wait_seconds",
          "legendFormat": "avg wait",
          "refId": "A"
        }
      ]
    },
    {
      "id": 5,
      "title": "Queue depth over time",
      "type": "timeseries",
      "gridPos": { "x": 0, "y": 6, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "claims_in_human_review_total",
          "legendFormat": "in_human_review",
          "refId": "A"
        }
      ]
    },
    {
      "id": 6,
      "title": "Approve/reject totals over time",
      "type": "timeseries",
      "gridPos": { "x": 12, "y": 6, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "claims_approved_total",
          "legendFormat": "approved",
          "refId": "A"
        },
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "claims_rejected_total",
          "legendFormat": "rejected",
          "refId": "B"
        }
      ]
    }
  ]
}
