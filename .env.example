# ============ LLM PROVIDER — PRIMARY (OpenAI, see docs/decisions/ADR-001) ============
OPENAI_API_KEY=sk-xxxxx           # https://platform.openai.com/api-keys
LLM_MODEL_CHEAP=gpt-4o-mini       # classification, triage, RAG routing
LLM_MODEL_STRONG=gpt-4o           # extraction, Text-to-SQL, RAG answers
LLM_TIMEOUT_SECONDS=30            # ceiling for a single request
LLM_SDK_MAX_RETRIES=1             # network / 429 / 5xx retries
LLM_MAX_RETRIES=2                 # instructor re-asks on a validation error

# ============ MASKING (S2-6) ============
MASKING_SANITY_ENABLED=true       # LLM sanity pass over masked text (extra OpenAI call per message).
                                   # Kapatmak için false yapın. DEMO_OFFLINE'dan bağımsız bir flag.

# ============ LLM PROVIDERS — FALLBACK (kept, not wired up yet) ============
# Not read by worker/llm/client.py today. Kept so a fallback layer stays
# possible without another round of decisions. See ADR-001, "Still open".
GROQ_API_KEY=gsk_xxxxx            # https://console.groq.com/keys
GEMINI_API_KEY=AIzaxxxxx          # https://aistudio.google.com/apikey
OLLAMA_HOST=http://ollama:11434   # local, docker compose service name
LLM_MODEL_STRONG_GROQ=llama-3.3-70b-versatile
LLM_MODEL_CHEAP_GROQ=llama-3.1-8b-instant
LLM_MODEL_GEMINI=gemini-2.0-flash-exp
LLM_MODEL_OLLAMA_LARGE=qwen2.5:7b
LLM_MODEL_OLLAMA_SMALL=llama3.1:8b

# ============ EMBEDDING (local, free) ============
EMBED_MODEL=paraphrase-multilingual-MiniLM-L12-v2
EMBED_DIM=384                     # must match the DDL's vector(384)

# ============ DATABASE ============
POSTGRES_USER=claims
POSTGRES_PASSWORD=change-me
POSTGRES_DB=claims_cockpit
DATABASE_URL=postgresql://claims:change-me@db:5432/claims_cockpit

# ============ REDIS ============
REDIS_URL=redis://redis:6379/0

# ============ AUTH ============
JWT_SECRET=replace-with-a-random-32-plus-character-string
JWT_EXPIRE_HOURS=24

# ============ DEMO ============
DEMO_OFFLINE=false
